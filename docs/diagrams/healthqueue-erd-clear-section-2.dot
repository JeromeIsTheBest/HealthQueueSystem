="left_Specialties" BGCOLOR="#f4f6f8">Specialties</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="8">-</FONT></TD><TD ALIGN="LEFT" PORT="right_Specialties" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="9">varchar(255) ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_OpenDays" BGCOLOR="#ffffff">OpenDays</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="8">-</FONT></TD><TD ALIGN="LEFT" PORT="right_OpenDays" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="9">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_OpenTime" BGCOLOR="#f4f6f8">OpenTime</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="8">-</FONT></TD><TD ALIGN="LEFT" PORT="right_OpenTime" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="9">time</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_CloseTime" BGCOLOR="#ffffff">CloseTime</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="8">-</FONT></TD><TD ALIGN="LEFT" PORT="right_CloseTime" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="9">time</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_RegistrationDate" BGCOLOR="#f4f6f8">RegistrationDate</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="8">-</FONT></TD><TD ALIGN="LEFT" PORT="right_RegistrationDate" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="9">datetime</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_DeletedAt" BGCOLOR="#ffffff">DeletedAt</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="8">-</FONT></TD><TD ALIGN="LEFT" PORT="right_DeletedAt" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="9">datetime ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_Status" BGCOLOR="#f4f6f8">Status</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="8">-</FONT></TD><TD ALIGN="LEFT" PORT="right_Status" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="9">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_archived" BGCOLOR="#ffffff">archived</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="8">-</FONT></TD><TD ALIGN="LEFT" PORT="right_archived" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="9">tinyint(4)</FONT></TD></TR>