digraph HealthQueue {
graph [rankdir=LR, bgcolor="white", splines=polyline, nodesep=0.25, ranksep=0.45, pad=0.5, outputorder=edgesfirst, forcelabels=true, fontname="Arial", fontsize=14, labelloc=t, label="HealthQueue - Notifications and audit\nPK primary key | FK foreign key | UQ unique | ? nullable\nR-numbers match the relationship index. Referenced tables repeat for context."];
node [shape=plain, fontname="Arial", fontsize=12];
edge [fontname="Arial", fontsize=9, color="#738697", fontcolor="#334b5d", arrowsize=0.7, penwidth=1.1];
"notifications" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#d4f0ef"><B>NOTIFICATIONS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_NotificationID" BGCOLOR="#ffffff">NotificationID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" PORT="right_NotificationID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_ClinicID" BGCOLOR="#f4f6f8">ClinicID</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT" PORT="right_ClinicID" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_Message" BGCOLOR="#ffffff">Message</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_Message" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_RelatedAppointmentID" BGCOLOR="#f4f6f8">RelatedAppointmentID</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT" PORT="right_RelatedAppointmentID" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">int(11) ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_IsRead" BGCOLOR="#ffffff">IsRead</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_IsRead" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">tinyint(4)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_CreatedAt" BGCOLOR="#f4f6f8">CreatedAt</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_CreatedAt" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">datetime</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_AnnouncementID" BGCOLOR="#ffffff">AnnouncementID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT" PORT="right_AnnouncementID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11) ?</FONT></TD></TR></TABLE>>];
"patientnotifications" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#d4f0ef"><B>PATIENTNOTIFICATIONS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_NotificationID" BGCOLOR="#ffffff">NotificationID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" PORT="right_NotificationID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_PatientID" BGCOLOR="#f4f6f8">PatientID</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT" PORT="right_PatientID" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_Message" BGCOLOR="#ffffff">Message</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_Message" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_RelatedAppointmentID" BGCOLOR="#f4f6f8">RelatedAppointmentID</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT" PORT="right_RelatedAppointmentID" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">int(11) ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_IsRead" BGCOLOR="#ffffff">IsRead</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_IsRead" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">tinyint(4)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_CreatedAt" BGCOLOR="#f4f6f8">CreatedAt</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_CreatedAt" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">datetime</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_AnnouncementID" BGCOLOR="#ffffff">AnnouncementID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT" PORT="right_AnnouncementID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11) ?</FONT></TD></TR></TABLE>>];
"announcements" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#d4f0ef"><B>ANNOUNCEMENTS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_AnnouncementID" BGCOLOR="#ffffff">AnnouncementID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" PORT="right_AnnouncementID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR></TABLE>>];
"appointments" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#d8f1da"><B>APPOINTMENTS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_AppointmentID" BGCOLOR="#ffffff">AppointmentID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" PORT="right_AppointmentID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR></TABLE>>];
"clinic" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#fff0c5"><B>CLINIC</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_ClinicID" BGCOLOR="#ffffff">ClinicID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" PORT="right_ClinicID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR></TABLE>>];
"users" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#d9edff"><B>USERS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_UserID" BGCOLOR="#ffffff">UserID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" PORT="right_UserID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR></TABLE>>];
"appointments":"right_AppointmentID":e -> "notifications":"left_RelatedAppointmentID":w [dir=both, arrowtail="odottee", arrowhead="crowodot", style="dashed", label="R49"];
"clinic":"right_ClinicID":e -> "notifications":"left_ClinicID":w [dir=both, arrowtail="teetee", arrowhead="crowodot", style="dashed", label="R50"];
