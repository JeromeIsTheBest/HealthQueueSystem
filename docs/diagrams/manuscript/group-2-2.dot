digraph HealthQueue {
graph [rankdir=LR, bgcolor="white", splines=polyline, nodesep=0.25, ranksep=0.45, pad=0.5, outputorder=edgesfirst, forcelabels=true, fontname="Arial", fontsize=14, labelloc=t, label="HealthQueue - Clinics and schedules\nPK primary key | FK foreign key | UQ unique | ? nullable\nR-numbers match the relationship index. Referenced tables repeat for context."];
node [shape=plain, fontname="Arial", fontsize=12];
edge [fontname="Arial", fontsize=9, color="#738697", fontcolor="#334b5d", arrowsize=0.7, penwidth=1.1];
"physicianavailability" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#fff0c5"><B>PHYSICIANAVAILABILITY</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_AvailabilityID" BGCOLOR="#ffffff">AvailabilityID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" PORT="right_AvailabilityID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_PhysicianID" BGCOLOR="#f4f6f8">PhysicianID</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT" PORT="right_PhysicianID" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_DayOfWeek" BGCOLOR="#ffffff">DayOfWeek</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_DayOfWeek" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">tinyint(4)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_StartTime" BGCOLOR="#f4f6f8">StartTime</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_StartTime" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">time</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_EndTime" BGCOLOR="#ffffff">EndTime</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_EndTime" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">time</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_PatientsPerHour" BGCOLOR="#f4f6f8">PatientsPerHour</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_PatientsPerHour" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">tinyint(4) ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_Active" BGCOLOR="#ffffff">Active</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_Active" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">tinyint(4)</FONT></TD></TR></TABLE>>];
"physiciandateavailability" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#fff0c5"><B>PHYSICIANDATEAVAILABILITY</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_SlotID" BGCOLOR="#ffffff">SlotID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" PORT="right_SlotID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_PhysicianID" BGCOLOR="#f4f6f8">PhysicianID</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT" PORT="right_PhysicianID" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_AvailDate" BGCOLOR="#ffffff">AvailDate</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_AvailDate" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_StartTime" BGCOLOR="#f4f6f8">StartTime</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_StartTime" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">time ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_EndTime" BGCOLOR="#ffffff">EndTime</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_EndTime" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">time ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_PatientsPerHour" BGCOLOR="#f4f6f8">PatientsPerHour</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_PatientsPerHour" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">tinyint(4) ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_IsDayOff" BGCOLOR="#ffffff">IsDayOff</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_IsDayOff" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">tinyint(4)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_CreatedAt" BGCOLOR="#f4f6f8">CreatedAt</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_CreatedAt" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">datetime</FONT></TD></TR></TABLE>>];
"users" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#d9edff"><B>USERS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_UserID" BGCOLOR="#ffffff">UserID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" PORT="right_UserID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR></TABLE>>];
"users":"right_UserID":e -> "physicianavailability":"left_PhysicianID":w [dir=both, arrowtail="teetee", arrowhead="crowodot", style="dashed", label="R59"];
"users":"right_UserID":e -> "physiciandateavailability":"left_PhysicianID":w [dir=both, arrowtail="teetee", arrowhead="crowodot", style="dashed", label="R60"];
