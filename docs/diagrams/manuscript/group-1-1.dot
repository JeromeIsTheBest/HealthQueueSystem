digraph HealthQueue {
graph [rankdir=LR, bgcolor="white", splines=polyline, nodesep=0.25, ranksep=0.45, pad=0.5, outputorder=edgesfirst, forcelabels=true, fontname="Arial", fontsize=14, labelloc=t, label="HealthQueue - Accounts and access\nPK primary key | FK foreign key | UQ unique | ? nullable\nR-numbers match the relationship index. Referenced tables repeat for context."];
node [shape=plain, fontname="Arial", fontsize=12];
edge [fontname="Arial", fontsize=9, color="#738697", fontcolor="#334b5d", arrowsize=0.7, penwidth=1.1];
"roles" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#d9edff"><B>ROLES</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_RoleID" BGCOLOR="#ffffff">RoleID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" PORT="right_RoleID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_RoleName" BGCOLOR="#f4f6f8">RoleName</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">UQ</FONT></TD><TD ALIGN="LEFT" PORT="right_RoleName" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">varchar(50)</FONT></TD></TR></TABLE>>];
"users" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#d9edff"><B>USERS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_UserID" BGCOLOR="#ffffff">UserID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" PORT="right_UserID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_IDNumber" BGCOLOR="#f4f6f8">IDNumber</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">UQ</FONT></TD><TD ALIGN="LEFT" PORT="right_IDNumber" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">char(10) ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_ClinicID" BGCOLOR="#ffffff">ClinicID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT" PORT="right_ClinicID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11) ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_RoleID" BGCOLOR="#f4f6f8">RoleID</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT" PORT="right_RoleID" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_FirstName" BGCOLOR="#ffffff">FirstName</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_FirstName" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">varchar(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_LastName" BGCOLOR="#f4f6f8">LastName</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_LastName" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">varchar(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_Email" BGCOLOR="#ffffff">Email</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">UQ</FONT></TD><TD ALIGN="LEFT" PORT="right_Email" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_EmailVerifiedAt" BGCOLOR="#f4f6f8">EmailVerifiedAt</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_EmailVerifiedAt" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">datetime ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_ContactNumber" BGCOLOR="#ffffff">ContactNumber</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_ContactNumber" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">varchar(20) ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_PasswordHash" BGCOLOR="#f4f6f8">PasswordHash</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_PasswordHash" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">varchar(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_CreatedAt" BGCOLOR="#ffffff">CreatedAt</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_CreatedAt" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">datetime</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_DeletedAt" BGCOLOR="#f4f6f8">DeletedAt</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_DeletedAt" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">datetime ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_Status" BGCOLOR="#ffffff">Status</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_Status" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_Archived" BGCOLOR="#f4f6f8">Archived</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_Archived" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">tinyint(4)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_AvailabilityStatus" BGCOLOR="#ffffff">AvailabilityStatus</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_AvailabilityStatus" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_ProfilePhoto" BGCOLOR="#f4f6f8">ProfilePhoto</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_ProfilePhoto" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">varchar(255) ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_WalletBalance" BGCOLOR="#ffffff">WalletBalance</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_WalletBalance" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">decimal(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_BloodType" BGCOLOR="#f4f6f8">BloodType</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_BloodType" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">varchar(5) ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_Allergies" BGCOLOR="#ffffff">Allergies</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_Allergies" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">varchar(500) ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_EmergencyContactName" BGCOLOR="#f4f6f8">EmergencyContactName</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_EmergencyContactName" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">varchar(100) ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_EmergencyContactNumber" BGCOLOR="#ffffff">EmergencyContactNumber</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_EmergencyContactNumber" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">varchar(20) ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_AnnouncementsSeenAt" BGCOLOR="#f4f6f8">AnnouncementsSeenAt</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_AnnouncementsSeenAt" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">datetime ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_PhysicianSpecialty" BGCOLOR="#ffffff">PhysicianSpecialty</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_PhysicianSpecialty" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">varchar(100) ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_AccountMobileNumber" BGCOLOR="#f4f6f8">AccountMobileNumber</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">UQ</FONT></TD><TD ALIGN="LEFT" PORT="right_AccountMobileNumber" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">varchar(20) ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_IsWalkInAccount" BGCOLOR="#ffffff">IsWalkInAccount</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_IsWalkInAccount" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">tinyint(4)</FONT></TD></TR></TABLE>>];
"clinic" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#fff0c5"><B>CLINIC</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_ClinicID" BGCOLOR="#ffffff">ClinicID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" PORT="right_ClinicID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR></TABLE>>];
"clinic":"right_ClinicID":e -> "users":"left_ClinicID":w [dir=both, arrowtail="odottee", arrowhead="crowodot", style="dashed", label="R75"];
"roles":"right_RoleID":e -> "users":"left_RoleID":w [dir=both, arrowtail="teetee", arrowhead="crowodot", style="dashed", label="R76"];
}