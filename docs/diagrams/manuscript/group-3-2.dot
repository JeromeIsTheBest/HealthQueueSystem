TD ALIGN="LEFT" PORT="left_RequestedAt" BGCOLOR="#f4f6f8">RequestedAt</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_RequestedAt" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">datetime</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_ReviewedBy" BGCOLOR="#ffffff">ReviewedBy</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT" PORT="right_ReviewedBy" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11) ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_ReviewedAt" BGCOLOR="#f4f6f8">ReviewedAt</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_ReviewedAt" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">datetime ?</FONT></TD></TR></TABLE>>];
