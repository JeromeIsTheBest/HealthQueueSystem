digraph HealthQueue {
graph [rankdir=LR, bgcolor="white", splines=polyline, nodesep=0.25, ranksep=0.45, pad=0.5, outputorder=edgesfirst, forcelabels=true, fontname="Arial", fontsize=14, labelloc=t, label="HealthQueue - Demo earnings and payouts\nPK primary key | FK foreign key | UQ unique | ? nullable\nR-numbers match the relationship index. Referenced tables repeat for context."];
node [shape=plain, fontname="Arial", fontsize=12];
edge [fontname="Arial", fontsize=9, color="#738697", fontcolor="#334b5d", arrowsize=0.7, penwidth=1.1];
"physicianwithdrawals" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#ffead4"><B>PHYSICIANWITHDRAWALS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_WithdrawalID" BGCOLOR="#ffffff">WithdrawalID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" PORT="right_WithdrawalID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_Reference" BGCOLOR="#f4f6f8">Reference</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">UQ</FONT></TD><TD ALIGN="LEFT" PORT="right_Reference" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">varchar(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_RequestKey" BGCOLOR="#ffffff">RequestKey</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">UQ</FONT></TD><TD ALIGN="LEFT" PORT="right_RequestKey" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">varchar(64)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_PhysicianID" BGCOLOR="#f4f6f8">PhysicianID</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT" PORT="right_PhysicianID" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_Amount" BGCOLOR="#ffffff">Amount</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_Amount" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">decimal(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_PayoutMethod" BGCOLOR="#f4f6f8">PayoutMethod</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_PayoutMethod" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_AccountName" BGCOLOR="#ffffff">AccountName</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_AccountName" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">varchar(150)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_AccountNumber" BGCOLOR="#f4f6f8">AccountNumber</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_AccountNumber" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">varchar(34)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_BankName" BGCOLOR="#ffffff">BankName</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_BankName" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">varchar(100) ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_Status" BGCOLOR="#f4f6f8">Status</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_Status" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_CreatedAt" BGCOLOR="#ffffff">CreatedAt</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_CreatedAt" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">datetime</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_ReviewedAt" BGCOLOR="#f4f6f8">ReviewedAt</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_ReviewedAt" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">datetime ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_ReviewedByUserID" BGCOLOR="#ffffff">ReviewedByUserID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT" PORT="right_ReviewedByUserID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11) ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_FinancialOwnerUserID" BGCOLOR="#f4f6f8">FinancialOwnerUserID</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT" PORT="right_FinancialOwnerUserID" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">int(11) ?</FONT></TD></TR></TABLE>>];
"platformdemobanktransfers" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#ffead4"><B>PLATFORMDEMOBANKTRANSFERS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_TransferID" BGCOLOR="#ffffff">TransferID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" PORT="right_TransferID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_PaymentID" BGCOLOR="#f4f6f8">PaymentID</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">FK, UQ</FONT></TD><TD ALIGN="LEFT" PORT="right_PaymentID" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_Reference" BGCOLOR="#ffffff">Reference</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">UQ</FONT></TD><TD ALIGN="LEFT" PORT="right_Reference" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">varchar(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_Amount" BGCOLOR="#f4f6f8">Amount</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_Amount" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">decimal(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_BankLabel" BGCOLOR="#ffffff">BankLabel</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_BankLabel" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_AccountLastFour" BGCOLOR="#f4f6f8">AccountLastFour</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_AccountLastFour" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">char(4)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_Status" BGCOLOR="#ffffff">Status</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_Status" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">varchar(30)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_CreatedAt" BGCOLOR="#f4f6f8">CreatedAt</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_CreatedAt" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">datetime</FONT></TD></TR></TABLE>>];
"appointmentpayments" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#ffead4"><B>APPOINTMENTPAYMENTS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_PaymentID" BGCOLOR="#ffffff">PaymentID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" PORT="right_PaymentID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR></TABLE>>];
"users" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#d9edff"><B>USERS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_UserID" BGCOLOR="#ffffff">UserID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" PORT="right_UserID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR></TABLE>>];
"users":"right_UserID":e -> "physicianwithdrawals":"left_FinancialOwnerUserID":w [dir=both, arrowtail="odottee", arrowhead="crowodot", style="dashed", label="R64"];
"users":"right_UserID":e -> "physicianwithdrawals":"left_PhysicianID":w [dir=both, arrowtail="teetee", arrowhead="crowodot", style="dashed", label="R65"];
"users":"right_UserID":e -> "physicianwithdrawals":"left_ReviewedByUserID":w [dir=both, arrowtail="odottee", arrowhead="crowodot", style="dashed", label="R66"];
"appointmentpayments":"right_PaymentID":e -> "platformdemobanktransfers":"left_PaymentID":w [dir=both, arrowtail="teetee", arrowhead="odottee", style="dashed", label="R67"];
}