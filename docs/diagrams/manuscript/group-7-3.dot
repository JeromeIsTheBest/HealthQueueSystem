"announcements" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#d4f0ef"><B>ANNOUNCEMENTS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_AnnouncementID" BGCOLOR="#ffffff">AnnouncementID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" PORT="right_AnnouncementID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR></TABLE>>];
"clinicfeerequests" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#fff0c5"><B>CLINICFEEREQUESTS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_RequestID" BGCOLOR="#ffffff">RequestID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" PORT="right_RequestID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR></TABLE>>];
"users" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#d9edff"><B>USERS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_UserID" BGCOLOR="#ffffff">UserID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" PORT="right_UserID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR></TABLE>>];
"announcements":"right_AnnouncementID":e -> "physiciannotifications":"left_AnnouncementID":w [dir=both, arrowtail="odottee", arrowhead="crowodot", style="dashed", label="R61"];
"users":"right_UserID":e -> "physiciannotifications":"left_PhysicianID":w [dir=both, arrowtail="teetee", arrowhead="crowodot", style="dashed", label="R62"];
"clinicfeerequests":"right_RequestID":e -> "physiciannotifications":"left_FeeRequestID":w [dir=both, arrowtail="odottee", arrowhead="odottee", style="dashed", label="R63"];
