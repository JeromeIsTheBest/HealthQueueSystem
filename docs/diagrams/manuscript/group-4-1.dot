digraph HealthQueue {
graph [rankdir=LR, bgcolor="white", splines=polyline, nodesep=0.25, ranksep=0.45, pad=0.5, outputorder=edgesfirst, forcelabels=true, fontname="Arial", fontsize=14, labelloc=t, label="HealthQueue - Consultations and AI\nPK primary key | FK foreign key | UQ unique | ? nullable\nR-numbers match the relationship index. Referenced tables repeat for context."];
node [shape=plain, fontname="Arial", fontsize=12];
edge [fontname="Arial", fontsize=9, color="#738697", fontcolor="#334b5d", arrowsize=0.7, penwidth=1.1];
"consultations" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#e8ddfa"><B>CONSULTATIONS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_ConsultationID" BGCOLOR="#ffffff">ConsultationID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" PORT="right_ConsultationID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_ClinicID" BGCOLOR="#f4f6f8">ClinicID</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT" PORT="right_ClinicID" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_AppointmentID" BGCOLOR="#ffffff">AppointmentID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">FK, UQ</FONT></TD><TD ALIGN="LEFT" PORT="right_AppointmentID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_PatientID" BGCOLOR="#f4f6f8">PatientID</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT" PORT="right_PatientID" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_DoctorID" BGCOLOR="#ffffff">DoctorID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT" PORT="right_DoctorID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_AudioFilePath" BGCOLOR="#f4f6f8">AudioFilePath</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_AudioFilePath" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">varchar(255) ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_AudioDurationSeconds" BGCOLOR="#ffffff">AudioDurationSeconds</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_AudioDurationSeconds" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11) ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_RecordingConsent" BGCOLOR="#f4f6f8">RecordingConsent</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_RecordingConsent" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">tinyint(4)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_CompletedAt" BGCOLOR="#ffffff">CompletedAt</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_CompletedAt" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">datetime</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_DeletedAt" BGCOLOR="#f4f6f8">DeletedAt</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_DeletedAt" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">datetime ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_Status" BGCOLOR="#ffffff">Status</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_Status" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_Archived" BGCOLOR="#f4f6f8">Archived</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_Archived" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">tinyint(4)</FONT></TD></TR></TABLE>>];
"consultationversions" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#e8ddfa"><B>CONSULTATIONVERSIONS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_VersionID" BGCOLOR="#ffffff">VersionID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" PORT="right_VersionID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_ConsultationID" BGCOLOR="#f4f6f8">ConsultationID</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT" PORT="right_ConsultationID" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_EditedByPhysicianID" BGCOLOR="#ffffff">EditedByPhysicianID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT" PORT="right_EditedByPhysicianID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_RevisionNumber" BGCOLOR="#f4f6f8">RevisionNumber</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_RevisionNumber" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_ClinicalNotes" BGCOLOR="#ffffff">ClinicalNotes</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_ClinicalNotes" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_PrescriptionText" BGCOLOR="#f4f6f8">PrescriptionText</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_PrescriptionText" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">text ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_NotesJson" BGCOLOR="#ffffff">NotesJson</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_NotesJson" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">text ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_UpdatedAt" BGCOLOR="#f4f6f8">UpdatedAt</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_UpdatedAt" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">datetime</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_DeletedAt" BGCOLOR="#ffffff">DeletedAt</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_DeletedAt" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">datetime ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_Status" BGCOLOR="#f4f6f8">Status</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_Status" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_Archived" BGCOLOR="#ffffff">Archived</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_Archived" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">tinyint(4)</FONT></TD></TR></TABLE>>];
"appointments" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#d8f1da"><B>APPOINTMENTS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_AppointmentID" BGCOLOR="#ffffff">AppointmentID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" PORT="right_AppointmentID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR></TABLE>>];
"clinic" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#fff0c5"><B>CLINIC</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_ClinicID" BGCOLOR="#ffffff">ClinicID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" PORT="right_ClinicID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR></TABLE>>];
"users" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#d9edff"><B>USERS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_UserID" BGCOLOR="#ffffff">UserID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" PORT="right_UserID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR></TABLE>>];
"appointments":"right_AppointmentID":e -> "consultations":"left_AppointmentID":w [dir=both, arrowtail="teetee", arrowhead="odottee", style="dashed", label="R27"];
"clinic":"right_ClinicID":e -> "consultations":"left_ClinicID":w [dir=both, arrowtail="teetee", arrowhead="crowodot", style="dashed", label="R28"];
"users":"right_UserID":e -> "consultations":"left_DoctorID":w [dir=both, arrowtail="teetee", arrowhead="crowodot", style="dashed", label="R29"];
"users":"right_UserID":e -> "consultations":"left_PatientID":w [dir=both, arrowtail="teetee", arrowhead="crowodot", style="dashed", label="R30"];
"consultations":"right_ConsultationID":e -> "consultationversions":"left_ConsultationID":w [dir=both, arrowtail="teetee", arrowhead="crowodot", style="dashed", label="R31"];
"users":"right_UserID":e -> "consultationversions":"left_EditedByPhysicianID":w [dir=both, arrowtail="teetee", arrowhead="crowodot", style="dashed", label="R32"];
}