digraph HealthQueue {
graph [rankdir=LR, bgcolor="white", splines=polyline, nodesep=0.25, ranksep=0.45, pad=0.5, outputorder=edgesfirst, forcelabels=true, fontname="Arial", fontsize=14, labelloc=t, label="HealthQueue - Medical record sharing\nPK primary key | FK foreign key | UQ unique | ? nullable\nR-numbers match the relationship index. Referenced tables repeat for context."];
node [shape=plain, fontname="Arial", fontsize=12];
edge [fontname="Arial", fontsize=9, color="#738697", fontcolor="#334b5d", arrowsize=0.7, penwidth=1.1];
"medicalrecords" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#f9dcf0"><B>MEDICALRECORDS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_RecordID" BGCOLOR="#ffffff">RecordID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" PORT="right_RecordID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_PatientID" BGCOLOR="#f4f6f8">PatientID</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT" PORT="right_PatientID" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_Title" BGCOLOR="#ffffff">Title</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_Title" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">varchar(150)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_Category" BGCOLOR="#f4f6f8">Category</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_Category" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">varchar(30)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_Description" BGCOLOR="#ffffff">Description</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_Description" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">text ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_FilePath" BGCOLOR="#f4f6f8">FilePath</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_FilePath" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">varchar(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_FileType" BGCOLOR="#ffffff">FileType</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_FileType" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">varchar(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_UploadedAt" BGCOLOR="#f4f6f8">UploadedAt</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_UploadedAt" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">datetime</FONT></TD></TR></TABLE>>];
"medicalrecordaccessrequests" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#f9dcf0"><B>MEDICALRECORDACCESSREQUESTS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_RequestID" BGCOLOR="#ffffff">RequestID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" PORT="right_RequestID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_AppointmentID" BGCOLOR="#f4f6f8">AppointmentID</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT" PORT="right_AppointmentID" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_PatientID" BGCOLOR="#ffffff">PatientID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT" PORT="right_PatientID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_PhysicianID" BGCOLOR="#f4f6f8">PhysicianID</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT" PORT="right_PhysicianID" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_Status" BGCOLOR="#ffffff">Status</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_Status" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_RequestedAt" BGCOLOR="#f4f6f8">RequestedAt</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_RequestedAt" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">datetime</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_RespondedAt" BGCOLOR="#ffffff">RespondedAt</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_RespondedAt" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">datetime ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_EndedAt" BGCOLOR="#f4f6f8">EndedAt</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_EndedAt" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">datetime ?</FONT></TD></TR></TABLE>>];
"appointments" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#d8f1da"><B>APPOINTMENTS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_AppointmentID" BGCOLOR="#ffffff">AppointmentID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" PORT="right_AppointmentID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR></TABLE>>];
"users" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#d9edff"><B>USERS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_UserID" BGCOLOR="#ffffff">UserID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" PORT="right_UserID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR></TABLE>>];
"appointments":"right_AppointmentID":e -> "medicalrecordaccessrequests":"left_AppointmentID":w [dir=both, arrowtail="teetee", arrowhead="crowodot", style="dashed", label="R45"];
"users":"right_UserID":e -> "medicalrecordaccessrequests":"left_PatientID":w [dir=both, arrowtail="teetee", arrowhead="crowodot", style="dashed", label="R46"];
"users":"right_UserID":e -> "medicalrecordaccessrequests":"left_PhysicianID":w [dir=both, arrowtail="teetee", arrowhead="crowodot", style="dashed", label="R47"];
"users":"right_UserID":e -> "medicalrecords":"left_PatientID":w [dir=both, arrowtail="teetee", arrowhead="crowodot", style="dashed", label="R48"];
}