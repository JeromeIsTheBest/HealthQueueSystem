digraph HealthQueue {
graph [rankdir=LR, bgcolor="white", splines=polyline, nodesep=0.25, ranksep=0.45, pad=0.5, outputorder=edgesfirst, forcelabels=true, fontname="Arial", fontsize=14, labelloc=t, label="HealthQueue - Medical record sharing\nPK primary key | FK foreign key | UQ unique | ? nullable\nR-numbers match the relationship index. Referenced tables repeat for context."];
node [shape=plain, fontname="Arial", fontsize=12];
edge [fontname="Arial", fontsize=9, color="#738697", fontcolor="#334b5d", arrowsize=0.7, penwidth=1.1];
"medicalrecordaccessfiles" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#f9dcf0"><B>MEDICALRECORDACCESSFILES</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_RequestID" BGCOLOR="#ffffff">RequestID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK, FK</FONT></TD><TD ALIGN="LEFT" PORT="right_RequestID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_RecordID" BGCOLOR="#f4f6f8">RecordID</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">PK, FK</FONT></TD><TD ALIGN="LEFT" PORT="right_RecordID" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR></TABLE>>];
"medicalrecordaccessnotifications" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#f9dcf0"><B>MEDICALRECORDACCESSNOTIFICATIONS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_NotificationID" BGCOLOR="#ffffff">NotificationID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK, FK</FONT></TD><TD ALIGN="LEFT" PORT="right_NotificationID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_RequestID" BGCOLOR="#f4f6f8">RequestID</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">FK, UQ</FONT></TD><TD ALIGN="LEFT" PORT="right_RequestID" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR></TABLE>>];
"medicalrecordaccessrequests" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#f9dcf0"><B>MEDICALRECORDACCESSREQUESTS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_RequestID" BGCOLOR="#ffffff">RequestID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" PORT="right_RequestID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR></TABLE>>];
"medicalrecords" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#f9dcf0"><B>MEDICALRECORDS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_RecordID" BGCOLOR="#ffffff">RecordID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" PORT="right_RecordID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR></TABLE>>];
"patientnotifications" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#d4f0ef"><B>PATIENTNOTIFICATIONS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_NotificationID" BGCOLOR="#ffffff">NotificationID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" PORT="right_NotificationID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR></TABLE>>];
"medicalrecordaccessrequests":"right_RequestID":e -> "medicalrecordaccessfiles":"left_RequestID":w [dir=both, arrowtail="teetee", arrowhead="crowodot", style="solid", label="R41"];
"medicalrecords":"right_RecordID":e -> "medicalrecordaccessfiles":"left_RecordID":w [dir=both, arrowtail="teetee", arrowhead="crowodot", style="solid", label="R42"];
"patientnotifications":"right_NotificationID":e -> "medicalrecordaccessnotifications":"left_NotificationID":w [dir=both, arrowtail="teetee", arrowhead="odottee", style="solid", label="R43"];
"medicalrecordaccessrequests":"right_RequestID":e -> "medicalrecordaccessnotifications":"left_RequestID":w [dir=both, arrowtail="teetee", arrowhead="odottee", style="dashed", label="R44"];
}