digraph HealthQueue {
graph [rankdir=LR, bgcolor="white", splines=polyline, nodesep=0.25, ranksep=0.45, pad=0.5, outputorder=edgesfirst, forcelabels=true, fontname="Arial", fontsize=14, labelloc=t, label="HealthQueue - Clinics and schedules\nPK primary key | FK foreign key | UQ unique | ? nullable\nR-numbers match the relationship index. Referenced tables repeat for context."];
node [shape=plain, fontname="Arial", fontsize=12];
edge [fontname="Arial", fontsize=9, color="#738697", fontcolor="#334b5d", arrowsize=0.7, penwidth=1.1];
"clinicphoto" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#fff0c5"><B>CLINICPHOTO</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_PhotoID" BGCOLOR="#ffffff">PhotoID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" PORT="right_PhotoID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_ClinicID" BGCOLOR="#f4f6f8">ClinicID</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT" PORT="right_ClinicID" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_Filename" BGCOLOR="#ffffff">Filename</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_Filename" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">varchar(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_CreatedAt" BGCOLOR="#f4f6f8">CreatedAt</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_CreatedAt" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">datetime</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_SortOrder" BGCOLOR="#ffffff">SortOrder</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_SortOrder" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR></TABLE>>];
"clinicfeerequests" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#fff0c5"><B>CLINICFEEREQUESTS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_RequestID" BGCOLOR="#ffffff">RequestID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" PORT="right_RequestID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_ClinicID" BGCOLOR="#f4f6f8">ClinicID</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT" PORT="right_ClinicID" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_RequestedBy" BGCOLOR="#ffffff">RequestedBy</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT" PORT="right_RequestedBy" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_CurrentFee" BGCOLOR="#f4f6f8">CurrentFee</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_CurrentFee" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">decimal(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_ProposedFee" BGCOLOR="#ffffff">ProposedFee</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_ProposedFee" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">decimal(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_EffectiveDate" BGCOLOR="#f4f6f8">EffectiveDate</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_EffectiveDate" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_Reason" BGCOLOR="#ffffff">Reason</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_Reason" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">varchar(1000)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_Status" BGCOLOR="#f4f6f8">Status</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_Status" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_RequestedAt" BGCOLOR="#ffffff">RequestedAt</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_RequestedAt" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">datetime</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_ReviewedBy" BGCOLOR="#f4f6f8">ReviewedBy</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT" PORT="right_ReviewedBy" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">int(11) ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_ReviewedAt" BGCOLOR="#ffffff">ReviewedAt</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_ReviewedAt" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">datetime ?</FONT></TD></TR></TABLE>>];
"clinic" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#fff0c5"><B>CLINIC</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_ClinicID" BGCOLOR="#ffffff">ClinicID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" PORT="right_ClinicID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR></TABLE>>];
"users" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#d9edff"><B>USERS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_UserID" BGCOLOR="#ffffff">UserID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" PORT="right_UserID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR></TABLE>>];
"clinic":"right_ClinicID":e -> "clinicfeerequests":"left_ClinicID":w [dir=both, arrowtail="teetee", arrowhead="crowodot", style="dashed", label="R23"];
"users":"right_UserID":e -> "clinicfeerequests":"left_RequestedBy":w [dir=both, arrowtail="teetee", arrowhead="crowodot", style="dashed", label="R24"];
"users":"right_UserID":e -> "clinicfeerequests":"left_ReviewedBy":w [dir=both, arrowtail="odottee", arrowhead="crowodot", style="dashed", label="R25"];
"clinic":"right_ClinicID":e -> "clinicphoto":"left_ClinicID":w [dir=both, arrowtail="teetee", arrowhead="crowodot", style="dashed", label="R26"];
}