digraph HealthQueue {
graph [rankdir=LR, bgcolor="white", splines=polyline, nodesep=0.25, ranksep=0.45, pad=0.5, outputorder=edgesfirst, forcelabels=true, fontname="Arial", fontsize=14, labelloc=t, label="HealthQueue - Demo earnings and payouts\nPK primary key | FK foreign key | UQ unique | ? nullable\nR-numbers match the relationship index. Referenced tables repeat for context."];
node [shape=plain, fontname="Arial", fontsize=12];
edge [fontname="Arial", fontsize=9, color="#738697", fontcolor="#334b5d", arrowsize=0.7, penwidth=1.1];
"appointmentpayments" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#ffead4"><B>APPOINTMENTPAYMENTS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_PaymentID" BGCOLOR="#ffffff">PaymentID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" PORT="right_PaymentID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_AppointmentID" BGCOLOR="#f4f6f8">AppointmentID</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">FK, UQ</FONT></TD><TD ALIGN="LEFT" PORT="right_AppointmentID" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_GrossAmount" BGCOLOR="#ffffff">GrossAmount</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_GrossAmount" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">decimal(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_PhysicianRevenue" BGCOLOR="#f4f6f8">PhysicianRevenue</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_PhysicianRevenue" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">decimal(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_PlatformCommission" BGCOLOR="#ffffff">PlatformCommission</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_PlatformCommission" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">decimal(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_PaymentStatus" BGCOLOR="#f4f6f8">PaymentStatus</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_PaymentStatus" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_PaidAt" BGCOLOR="#ffffff">PaidAt</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_PaidAt" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">datetime</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_RefundedAt" BGCOLOR="#f4f6f8">RefundedAt</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_RefundedAt" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">datetime ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_FinancialOwnerUserID" BGCOLOR="#ffffff">FinancialOwnerUserID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT" PORT="right_FinancialOwnerUserID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11) ?</FONT></TD></TR></TABLE>>];
"wallettransactions" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#ffead4"><B>WALLETTRANSACTIONS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_TransactionID" BGCOLOR="#ffffff">TransactionID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" PORT="right_TransactionID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_PatientID" BGCOLOR="#f4f6f8">PatientID</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT" PORT="right_PatientID" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_Type" BGCOLOR="#ffffff">Type</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_Type" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_Amount" BGCOLOR="#f4f6f8">Amount</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_Amount" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">decimal(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_BalanceAfter" BGCOLOR="#ffffff">BalanceAfter</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_BalanceAfter" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">decimal(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_RelatedAppointmentID" BGCOLOR="#f4f6f8">RelatedAppointmentID</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT" PORT="right_RelatedAppointmentID" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">int(11) ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_Description" BGCOLOR="#ffffff">Description</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_Description" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">varchar(255) ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_CreatedAt" BGCOLOR="#f4f6f8">CreatedAt</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_CreatedAt" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">datetime</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_RequestKey" BGCOLOR="#ffffff">RequestKey</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">UQ</FONT></TD><TD ALIGN="LEFT" PORT="right_RequestKey" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">char(64) ?</FONT></TD></TR></TABLE>>];
"appointments" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#d8f1da"><B>APPOINTMENTS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_AppointmentID" BGCOLOR="#ffffff">AppointmentID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" PORT="right_AppointmentID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR></TABLE>>];
"users" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#d9edff"><B>USERS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_UserID" BGCOLOR="#ffffff">UserID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" PORT="right_UserID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR></TABLE>>];
"appointments":"right_AppointmentID":e -> "appointmentpayments":"left_AppointmentID":w [dir=both, arrowtail="teetee", arrowhead="odottee", style="dashed", label="R12"];
"users":"right_UserID":e -> "appointmentpayments":"left_FinancialOwnerUserID":w [dir=both, arrowtail="odottee", arrowhead="crowodot", style="dashed", label="R13"];
"appointments":"right_AppointmentID":e -> "wallettransactions":"left_RelatedAppointmentID":w [dir=both, arrowtail="odottee", arrowhead="crowodot", style="dashed", label="R85"];
"users":"right_UserID":e -> "wallettransactions":"left_PatientID":w [dir=both, arrowtail="teetee", arrowhead="crowodot", style="dashed", label="R86"];
}