digraph HealthQueue {
graph [rankdir=LR, bgcolor="white", splines=polyline, nodesep=0.25, ranksep=0.45, pad=0.5, outputorder=edgesfirst, forcelabels=true, fontname="Arial", fontsize=14, labelloc=t, label="HealthQueue - Accounts and access\nPK primary key | FK foreign key | UQ unique | ? nullable\nR-numbers match the relationship index. Referenced tables repeat for context."];
node [shape=plain, fontname="Arial", fontsize=12];
edge [fontname="Arial", fontsize=9, color="#738697", fontcolor="#334b5d", arrowsize=0.7, penwidth=1.1];
"requestratelimits" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#d9edff"><B>REQUESTRATELIMITS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_BucketKey" BGCOLOR="#ffffff">BucketKey</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" PORT="right_BucketKey" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">char(64)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_WindowStart" BGCOLOR="#f4f6f8">WindowStart</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_WindowStart" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">datetime</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_Attempts" BGCOLOR="#ffffff">Attempts</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_Attempts" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR></TABLE>>];
}