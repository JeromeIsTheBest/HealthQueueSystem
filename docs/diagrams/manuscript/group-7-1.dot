digraph HealthQueue {
graph [rankdir=LR, bgcolor="white", splines=polyline, nodesep=0.25, ranksep=0.45, pad=0.5, outputorder=edgesfirst, forcelabels=true, fontname="Arial", fontsize=14, labelloc=t, label="HealthQueue - Notifications and audit\nPK primary key | FK foreign key | UQ unique | ? nullable\nR-numbers match the relationship index. Referenced tables repeat for context."];
node [shape=plain, fontname="Arial", fontsize=12];
edge [fontname="Arial", fontsize=9, color="#738697", fontcolor="#334b5d", arrowsize=0.7, penwidth=1.1];
"announcements" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#d4f0ef"><B>ANNOUNCEMENTS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_AnnouncementID" BGCOLOR="#ffffff">AnnouncementID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" PORT="right_AnnouncementID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_PostedByUserID" BGCOLOR="#f4f6f8">PostedByUserID</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT" PORT="right_PostedByUserID" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_ClinicID" BGCOLOR="#ffffff">ClinicID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT" PORT="right_ClinicID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11) ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_Title" BGCOLOR="#f4f6f8">Title</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_Title" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">varchar(150)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_Category" BGCOLOR="#ffffff">Category</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_Category" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">varchar(30)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_Message" BGCOLOR="#f4f6f8">Message</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_Message" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_PhotoPath" BGCOLOR="#ffffff">PhotoPath</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_PhotoPath" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">varchar(255) ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_Audience" BGCOLOR="#f4f6f8">Audience</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_Audience" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_AffectsDate" BGCOLOR="#ffffff">AffectsDate</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_AffectsDate" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">date ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_CreatedAt" BGCOLOR="#f4f6f8">CreatedAt</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_CreatedAt" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">datetime</FONT></TD></TR></TABLE>>];
"announcementdismissals" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#d4f0ef"><B>ANNOUNCEMENTDISMISSALS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_UserID" BGCOLOR="#ffffff">UserID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK, FK</FONT></TD><TD ALIGN="LEFT" PORT="right_UserID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_AnnouncementID" BGCOLOR="#f4f6f8">AnnouncementID</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">PK, FK</FONT></TD><TD ALIGN="LEFT" PORT="right_AnnouncementID" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_DismissedAt" BGCOLOR="#ffffff">DismissedAt</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_DismissedAt" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">datetime</FONT></TD></TR></TABLE>>];
"clinic" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#fff0c5"><B>CLINIC</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_ClinicID" BGCOLOR="#ffffff">ClinicID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" PORT="right_ClinicID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR></TABLE>>];
"users" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#d9edff"><B>USERS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_UserID" BGCOLOR="#ffffff">UserID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" PORT="right_UserID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR></TABLE>>];
"announcements":"right_AnnouncementID":e -> "announcementdismissals":"left_AnnouncementID":w [dir=both, arrowtail="teetee", arrowhead="crowodot", style="solid", label="R08"];
"users":"right_UserID":e -> "announcementdismissals":"left_UserID":w [dir=both, arrowtail="teetee", arrowhead="crowodot", style="solid", label="R09"];
"clinic":"right_ClinicID":e -> "announcements":"left_ClinicID":w [dir=both, arrowtail="odottee", arrowhead="crowodot", style="dashed", label="R10"];
"users":"right_UserID":e -> "announcements":"left_PostedByUserID":w [dir=both, arrowtail="teetee", arrowhead="crowodot", style="dashed", label="R11"];
}