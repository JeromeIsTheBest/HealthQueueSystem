digraph HealthQueue {
graph [rankdir=LR, bgcolor="white", splines=polyline, nodesep=0.25, ranksep=0.45, pad=0.5, outputorder=edgesfirst, forcelabels=true, fontname="Arial", fontsize=14, labelloc=t, label="HealthQueue - Demo earnings and payouts\nPK primary key | FK foreign key | UQ unique | ? nullable\nR-numbers match the relationship index. Referenced tables repeat for context."];
node [shape=plain, fontname="Arial", fontsize=12];
edge [fontname="Arial", fontsize=9, color="#738697", fontcolor="#334b5d", arrowsize=0.7, penwidth=1.1];
"demosettlements" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#ffead4"><B>DEMOSETTLEMENTS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_SettlementID" BGCOLOR="#ffffff">SettlementID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" PORT="right_SettlementID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_RequestKey" BGCOLOR="#f4f6f8">RequestKey</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">UQ</FONT></TD><TD ALIGN="LEFT" PORT="right_RequestKey" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">varchar(64)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_Reference" BGCOLOR="#ffffff">Reference</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">UQ</FONT></TD><TD ALIGN="LEFT" PORT="right_Reference" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">varchar(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_GrossAmount" BGCOLOR="#f4f6f8">GrossAmount</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_GrossAmount" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">decimal(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_CreatedByUserID" BGCOLOR="#ffffff">CreatedByUserID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT" PORT="right_CreatedByUserID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_CreatedAt" BGCOLOR="#f4f6f8">CreatedAt</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">-</FONT></TD><TD ALIGN="LEFT" PORT="right_CreatedAt" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">datetime</FONT></TD></TR></TABLE>>];
"demosettlementitems" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#ffead4"><B>DEMOSETTLEMENTITEMS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_SettlementID" BGCOLOR="#ffffff">SettlementID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK, FK</FONT></TD><TD ALIGN="LEFT" PORT="right_SettlementID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_PaymentID" BGCOLOR="#f4f6f8">PaymentID</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="10">PK, FK, UQ</FONT></TD><TD ALIGN="LEFT" PORT="right_PaymentID" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR></TABLE>>];
"appointmentpayments" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#ffead4"><B>APPOINTMENTPAYMENTS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_PaymentID" BGCOLOR="#ffffff">PaymentID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" PORT="right_PaymentID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR></TABLE>>];
"users" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#d9edff"><B>USERS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_UserID" BGCOLOR="#ffffff">UserID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" PORT="right_UserID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="11">int(11)</FONT></TD></TR></TABLE>>];
"appointmentpayments":"right_PaymentID":e -> "demosettlementitems":"left_PaymentID":w [dir=both, arrowtail="teetee", arrowhead="odottee", style="solid", label="R33"];
"demosettlements":"right_SettlementID":e -> "demosettlementitems":"left_SettlementID":w [dir=both, arrowtail="teetee", arrowhead="crowodot", style="solid", label="R34"];
"users":"right_UserID":e -> "demosettlements":"left_CreatedByUserID":w [dir=both, arrowtail="teetee", arrowhead="crowodot", style="dashed", label="R35"];
}