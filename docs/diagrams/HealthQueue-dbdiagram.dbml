  Indexes {
    Email [unique, name: "Email"]
    IDNumber [unique, name: "IDNumber"]
    IDNumber [unique, name: "uq_users_idnumber"]
    AccountMobileNumber [unique, name: "uq_users_account_mobile"]
    RoleID [name: "fk_users_role"]
    ClinicID [name: "fk_users_clinic"]
  }
}

Table "visitcompletionnotifications" {
  "NotificationID" int(11) [pk, not null]
  "AppointmentID" int(11) [not null]
  "FinalizedVersionID" int(11) [not null]

  Indexes {
    (AppointmentID, FinalizedVersionID) [unique, name: "uq_visit_confirmation_notice"]
    FinalizedVersionID [name: "FinalizedVersionID"]
  }
}

Table "visitcompletionreviews" {
  "AppointmentID" int(11) [pk, not null]
  "PatientID" int(11) [not null]
  "ClinicID" int(11) [not null]
  "FinalizedVersionID" int(11) [not null]
  "Status" varchar(24) [not null, default: 'AwaitingPatient']
  "IssueText" text
  "RequestedAt" datetime [not null, default: `current_timestamp()`]
  "PatientRespondedAt" datetime
  "CompletedAt" datetime
  "CompletedByUserID" int(11)
  "CompletionSource" varchar(20)
  "StaffResolution" text

  Indexes {
    (ClinicID, Status) [name: "idx_visit_completion_clinic"]
    (PatientID, Status) [name: "idx_visit_completion_patient"]
    FinalizedVersionID [name: "FinalizedVersionID"]
    CompletedByUserID [name: "CompletedByUserID"]
  }
}

Table "wallettransactions" {
  "TransactionID" int(11) [pk, not null, increment]
  "PatientID" int(11) [not null]
  "Type" varchar(20) [not null]
  "Amount" decimal(10,2) [not null]
  "BalanceAfter" decimal(10,2) [not null]
  "RelatedAppointmentID" int(11)
  "Description" varchar(255)
  "CreatedAt" datetime [not null, default: `current_timestamp()`]
  "RequestKey" char(64)

  Indexes {
    RequestKey [unique, name: "uq_wallet_request_key"]
    RelatedAppointmentID [name: "fk_wallettx_appointment"]
    (PatientID, CreatedAt) [name: "idx_wallettx_patient"]
  }
}

