digraph HealthQueue {
graph [rankdir=LR, bgcolor="white", splines=polyline, nodesep=0.65, ranksep=1.5, pad=0.5, outputorder=edgesfirst, forcelabels=true, fontname="Arial", fontsize=18, labelloc=t, label="HealthQueue - Demo earnings and payouts\nHealthQueue actual schema | 2026-11-21\nPK primary key | FK foreign key | UQ unique | ? nullable | Crow-foot notation: circle = zero, bar = one, fork = many\nSolid: identifying FK (part of child PK). Dashed: non-identifying FK. R-number matches the relationship index."];
node [shape=plain, fontname="Arial", fontsize=10];
edge [fontname="Arial", fontsize=9, color="#738697", fontcolor="#334b5d", arrowsize=0.7, penwidth=1.1];
"appointmentpayments" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c4cf"><TR><TD COLSPAN="3" BGCOLOR="#ffead4"><B>APPOINTMENTPAYMENTS</B></TD></TR><TR><TD ALIGN="LEFT" PORT="left_PaymentID" BGCOLOR="#ffffff">PaymentID</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT" PORT="right_PaymentID" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="9">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_AppointmentID" BGCOLOR="#f4f6f8">AppointmentID</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="8">FK, UQ</FONT></TD><TD ALIGN="LEFT" PORT="right_AppointmentID" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="9">int(11)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_GrossAmount" BGCOLOR="#ffffff">GrossAmount</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="8">-</FONT></TD><TD ALIGN="LEFT" PORT="right_GrossAmount" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="9">decimal(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_PhysicianRevenue" BGCOLOR="#f4f6f8">PhysicianRevenue</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="8">-</FONT></TD><TD ALIGN="LEFT" PORT="right_PhysicianRevenue" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="9">decimal(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_PlatformCommission" BGCOLOR="#ffffff">PlatformCommission</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="8">-</FONT></TD><TD ALIGN="LEFT" PORT="right_PlatformCommission" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-SIZE="9">decimal(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_PaymentStatus" BGCOLOR="#f4f6f8">PaymentStatus</TD><TD BGCOLOR="#f4f6f8"><FONT POINT-SIZE="8">-</FONT></TD><TD ALIGN="LEFT" PORT="right_PaymentStatus" BGCOLOR="#f4f6f8"><FONT COLOR="#506277" POINT-SIZE="9">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="left_PaidAt" BGCOLOR="#ffffff">PaidAt</TD><TD BGCOLOR="#ffffff"><FONT POINT-SIZE="8">-</FONT></TD><TD ALIGN="LEFT" PORT="right_PaidAt" BGCOLOR="#ffffff"><FONT COLOR="#506277" POINT-S